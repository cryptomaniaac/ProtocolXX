# Unread Catchup — Environment Variables
#
# The chat-analysis feature needs NO env vars (fully local, no backend).
# These are only required for the email OTP login feature:
#
# RESEND_API_KEY — your Resend API key (smtp password).
#   Get one at https://resend.com/api-keys
#   NEVER put this in source code or commit it.
# RESEND_API_KEY=re_...
#
# JWT_SECRET — random secret for signing OTP tokens and session cookies.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   NEVER put this in source code or commit it.
# JWT_SECRET=...
#
# FROM_EMAIL — verified sender address in your Resend account.
#   Use onboarding@resend.dev for testing (no domain verification needed).
# FROM_EMAIL=onboarding@resend.dev
